rules_version = "2";

// =============================================================
// Regles de securite Firestore - Talent'Up SN
// A coller dans : Firebase Console > Firestore Database > Rules
// =============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Fonctions utilitaires ----------
    function estConnecte() {
      return request.auth != null;
    }

    function profilExiste() {
      return exists(/databases/$(database)/documents/utilisateurs/$(request.auth.uid));
    }

    function monRole() {
      return profilExiste()
        ? get(/databases/$(database)/documents/utilisateurs/$(request.auth.uid)).data.role
        : "invite";
    }

    function estAdmin() {
      return estConnecte() && monRole() == "admin";
    }

    // ---------- Collection utilisateurs ----------
    match /utilisateurs/{userId} {
      allow read: if estConnecte() && (request.auth.uid == userId || estAdmin());

      allow create: if estConnecte() && request.auth.uid == userId
                    && request.resource.data.role in ["etudiant", "entreprise"];

      allow update: if estConnecte() && request.auth.uid == userId
                    && (
                      !("role" in resource.data) ||
                      !("role" in request.resource.data) ||
                      request.resource.data.role == resource.data.role
                    );

      allow update, delete: if estAdmin();
    }

    // ---------- Collection offres ----------
    match /offres/{offreId} {
      allow read: if resource.data.statut == "validee"
                  || (estConnecte() && request.auth.uid == resource.data.entrepriseId)
                  || estAdmin();

      allow create: if estConnecte() && monRole() == "entreprise"
                    && request.resource.data.entrepriseId == request.auth.uid
                    && request.resource.data.statut == "en_attente";

      allow update: if estAdmin()
                    || (estConnecte() && request.auth.uid == resource.data.entrepriseId
                        && request.resource.data.statut == resource.data.statut
                        && request.resource.data.entrepriseId == resource.data.entrepriseId);

      allow delete: if estAdmin() || (estConnecte() && request.auth.uid == resource.data.entrepriseId);
    }

    // ---------- Collection candidatures ----------
    match /candidatures/{candidatureId} {
      allow read: if estConnecte() &&
                  (request.auth.uid == resource.data.etudiantId
                   || request.auth.uid == resource.data.entrepriseId
                   || estAdmin());

      allow create: if estConnecte() && monRole() == "etudiant"
                    && request.resource.data.etudiantId == request.auth.uid
                    && request.resource.data.statut == "envoyee"
                    && exists(/databases/$(database)/documents/offres/$(request.resource.data.offreId))
                    && get(/databases/$(database)/documents/offres/$(request.resource.data.offreId)).data.statut == "validee"
                    && get(/databases/$(database)/documents/offres/$(request.resource.data.offreId)).data.entrepriseId == request.resource.data.entrepriseId;

      allow update: if estAdmin()
                    || (estConnecte() && request.auth.uid == resource.data.entrepriseId
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["statut"]));

      allow delete: if estAdmin();
    }

    // ---------- Collection demandesCoaching (module Formation & Coaching) ----------
    match /demandesCoaching/{demandeId} {
      allow read: if estConnecte() &&
                  (request.auth.uid == resource.data.candidatId || estAdmin());

      allow create: if estConnecte() && monRole() == "etudiant"
                    && request.resource.data.candidatId == request.auth.uid
                    && request.resource.data.statut == "nouvelle";

      allow update, delete: if estAdmin();
    }
  }
}
